# Anthropic Claude API key — REQUIRED ONLY for AI generation of exercises
# that are not already in the bundled 876-exercise dataset.
# Core search + 873 visual demonstrations work with NO key at all.
# NOTE: Claude generates the text/structured guide + pose diagram. It does NOT
# generate video.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# (Optional) YouTube Data API v3 key for the "Dive Deep · Watch the Movement"
# section. WITHOUT a key, the app still embeds a demonstration inline for free
# using a keyless YouTube search embed. WITH a key, each exercise is resolved to
# one concrete, embeddable video and cached to data/videos/<slug>.json (more
# reliable). The Data API has a generous free daily quota.
# Get one at https://console.cloud.google.com/ (enable "YouTube Data API v3").
YOUTUBE_API_KEY=

# (Optional, legacy) Google Gemini (Veo) key for generating original rep-tension
# clips with an AI video model. Not used by the current YouTube-embed flow.
# Generation is slow and billed per generation; results cache to public/demos/.
GEMINI_API_KEY=

# (Optional, legacy) Override the Veo model. Default veo-3.1-fast-generate-preview.
GEMINI_VIDEO_MODEL=

